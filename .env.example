# FCIAZ Web — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored.

# -------------------------------------------------------------------
# Sanity CMS (content management for news, events, resources)
# Create a free project at https://www.sanity.io — get Project ID + API token.
# Without these set, the public site falls back to hardcoded content.
# -------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Read token (Viewer permissions). Used by server components to fetch content.
# Add at https://www.sanity.io/manage/api → Tokens → Add API token → Viewer
# Then paste the token into .env.local (NOT this file — it's git-ignored).
SANITY_API_READ_TOKEN=your_read_token_here


# -------------------------------------------------------------------
# Site
# -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="FCIAZ"

# -------------------------------------------------------------------
# Supabase (newsletter subscribers + volunteer signups + contact log)
# Create a project at https://supabase.com and run supabase/schema.sql
# in the SQL editor to create the required tables.
# -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (server-only) for inserts that bypass RLS.
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------------
# Resend (transactional email: contact form, volunteer confirmation)
# Sign up at https://resend.com and verify your sending domain
# (e.g. fciaz.org.zm) before going live.
# -------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=FCIAZ <noreply@fciaz.org.zm>
RESEND_TO_EMAIL=info@fciaz.org.zm

# -------------------------------------------------------------------
# WhatsApp (floating chat button)
# International format, no plus sign, no spaces: e.g. 260971234567
# -------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=260971234567
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hello FCIAZ, I'd like to learn more about your work."

# -------------------------------------------------------------------
# Donations — shown on /donate page (read at build/render time)
# -------------------------------------------------------------------
NEXT_PUBLIC_DONATE_BANK_NAME="Zambia National Commercial Bank"
NEXT_PUBLIC_DONATE_BANK_ACCOUNT_NAME="Fistula and Childbirth Injuries Association of Zambia"
NEXT_PUBLIC_DONATE_BANK_ACCOUNT_NUMBER="0000000000000"
NEXT_PUBLIC_DONATE_BANK_BRANCH="Lusaka Main Branch"
NEXT_PUBLIC_DONATE_BANK_SWIFT="ZNCBZMLU"

NEXT_PUBLIC_DONATE_MTN_MOMO_NAME="FCIAZ MTN MoMo"
NEXT_PUBLIC_DONATE_MTN_MOMO_NUMBER="0971234567"
NEXT_PUBLIC_DONATE_AIRTEL_MONEY_NAME="FCIAZ Airtel Money"
NEXT_PUBLIC_DONATE_AIRTEL_MONEY_NUMBER="0971234567"
NEXT_PUBLIC_DONATE_ZAMTEL_MONEY_NAME="FCIAZ Zamtel Money"
NEXT_PUBLIC_DONATE_ZAMTEL_MONEY_NUMBER="0971234567"
